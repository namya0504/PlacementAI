rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Firestore access is mediated by the authenticated Express API using the
    // Admin SDK. The browser currently uses Firebase Auth only, so no client
    // Firestore reads or writes are required.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
